+name: Campus Life Assistant CI/CD
+on:
+  push:
+    branches: [ main, campus-life-assistant ]
+  pull_request:
+    branches: [ main ]
+
+jobs:
+  build-and-test:
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout code
+        uses: actions/checkout@v4
+
+      - name: Set up Node.js 18.x
+        uses: actions/setup-node@v4
+        with:
+          node-version: 18.x
+          cache: 'npm'
+
+      - name: Install dependencies
+        run: npm ci
+
+      - name: Lint code
+        run: npm run lint --if-present
+
+      - name: Build project
+        run: npm run build --if-present
+
+      - name: Start server (background)
+        run: npm run start & sleep 15
+
+      - name: Test Admin login (Remember Me)
+        run: |
+          RESP=$(curl -s -X POST http://localhost:3000/api/admin/login \
+            -H "Content-Type: application/json" \
+            -d '{"username":"admin","password":"admin123"}')
+          TOKEN=$(echo $RESP | jq -r .data.token)
+          if [ "$TOKEN" = "null" ]; then
+            echo "Admin login failed"
+            exit 1
+          fi
+          echo "Admin login success, token: $TOKEN"
+
+      - name: Test RBAC & Tenant API
+        run: |
+          TOKEN=$(curl -s -X POST http://localhost:3000/api/admin/login -H "Content-Type: application/json" -d '{"username":"admin","password":"admin123"}' | jq -r .data.token)
+          # Test tenant list
+          TENANT_RESP=$(curl -s -H "Authorization: Bearer $TOKEN" http://localhost:3000/api/admin/tenants)
+          if echo $TENANT_RESP | grep -q "code.*200"; then
+            echo "Tenant API test success"
+          else
+            echo "Tenant API test failed"
+            exit 1
+          fi
+          # Test migration list
+          MIGRATION_RESP=$(curl -s -H "Authorization: Bearer $TOKEN" http://localhost:3000/api/admin/migrations/list)
+          if echo $MIGRATION_RESP | grep -q "code.*200"; then
+            echo "Migration API test success"
+          else
+            echo "Migration API test failed"
+            exit 1
+          fi
+
+      - name: Test WeChat Invite API
+        run: |
+          TOKEN=$(curl -s -X POST http://localhost:3000/api/admin/login -H "Content-Type: application/json" -d '{"username":"admin","password":"admin123"}' | jq -r .data.token)
+          INVITE_RESP=$(curl -s -X POST http://localhost:3000/api/friend/invite \
+            -H "Content-Type: application/json" \
+            -H "Authorization: Bearer $TOKEN" \
+            -d '{"userId":"1","inviteCode":"campus2026"}')
+          if echo $INVITE_RESP | grep -q "inviteUrl"; then
+            echo "WeChat invite API test success"
+          else
+            echo "WeChat invite API test failed"
+            exit 1
+          fi
