 <template>
   <div class="login-container">
     <h1>校园生活助手 - 管理员登录</h1>
     <el-form :model="loginForm" label-width="80px">
       <el-form-item label="用户名">
         <el-input v-model="loginForm.username"></el-input>
       </el-form-item>
       <el-form-item label="密码">
         <el-input v-model="loginForm.password" type="password"></el-input>
       </el-form-item>
+      <el-form-item>
+        <el-checkbox v-model="loginForm.rememberMe">记住登录状态</el-checkbox>
+      </el-form-item>
       <el-form-item>
         <el-button type="primary" @click="handleLogin">登录</el-button>
       </el-form-item>
     </el-form>
+    <!-- 分享入口（测试用） -->
+    <el-button type="text" @click="handleShare" style="margin-top: 20px">分享到微信</el-button>
   </div>
 </template>

 <script>
 export default {
   name: 'AdminLogin',
   data() {
     return {
       loginForm: {
         username: '',
         password: '',
+        rememberMe: false
       }
     }
   },
   methods: {
     async handleLogin() {
       try {
         const res = await this.$http.post('/api/admin/login', this.loginForm)
         if (res.code === 200) {
           // Remember Me: localStorage / sessionStorage
           const storage = this.loginForm.rememberMe ? localStorage : sessionStorage
           storage.setItem('admin_token', res.data.token)
           this.$message.success('登录成功')
           this.$router.push('/admin/dashboard')
         }
       } catch (err) {
         this.$message.error('登录失败')
       }
     },
+    handleShare() {
+      // Web Share API 优先，降级显示二维码
+      if (navigator.share) {
+        navigator.share({
+          title: '校园生活助手',
+          text: '邀请你使用校园生活助手',
+          url: window.location.href
+        }).catch(err => console.log('分享失败:', err))
+      } else {
+        // 调用邀请接口生成二维码
+        this.$http.post('/api/friend/invite', { userId: '1' }).then(res => {
+          this.$alert(`<img src="${res.data.qrCode}" />`, '分享二维码', {
+            dangerouslyUseHTMLString: true
+          })
+        })
+      }
+    }
   },
+  mounted() {
+    // 自动恢复登录状态
+    const token = localStorage.getItem('admin_token') || sessionStorage.getItem('admin_token')
+    if (token) {
+      this.$http.defaults.headers.common['Authorization'] = `Bearer ${token}`
+      this.$router.push('/admin/dashboard')
+    }
+  }
 }
 </script>