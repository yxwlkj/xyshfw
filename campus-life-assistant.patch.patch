 const express = require('express')
 const app = express()
+const jwt = require('jsonwebtoken')
+app.use(express.json())
+
+// JWT config
+const JWT_SECRET = process.env.JWT_SECRET || '8f9d6e5c4b3a2s1d9f8g7h6j5k4l3m2n1b8v7c6x5d4s3a2z1q9w8e7r6t5y4u3i2o1p'
+
+// Admin login (Remember Me support)
+app.post('/api/admin/login', (req, res) => {
+  const { username, password } = req.body
+  if (username === 'admin' && password === 'admin123') {
+    const token = jwt.sign({ username, role: 'admin' }, JWT_SECRET, { expiresIn: '7d' }) // 7天有效期（适配Remember Me）
+    res.json({ code: 200, msg: '登录成功', data: { token } })
+  } else {
+    res.json({ code: 401, msg: '账号或密码错误' })
+  }
+})
+
+// WeChat invite API
